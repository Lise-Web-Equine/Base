NUXT_SANITY_PROJECT_ID="<paste your project ID here>"
NUXT_SANITY_DATASET="production"
NUXT_SANITY_API_READ_TOKEN=""
NUXT_SANITY_API_VERSION="2025-02-04"
NUXT_SANITY_STUDIO_URL="http://localhost:3333"

# URL canonique du site en production (sans slash final). Indispensable pour
# le SEO : sitemap, robots.txt, URLs canoniques et balises Open Graph.
NUXT_PUBLIC_SITE_URL="https://www.exemple.com"
# Nom du site, utilisé dans les balises Open Graph et les données structurées.
NUXT_PUBLIC_SITE_NAME="Nom du site"

# Formulaire de contact (envoi via Resend, côté serveur uniquement). Sans ces
# trois variables, le formulaire renvoie une erreur 500.
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=""
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO=""
# Expéditeur des e-mails : doit appartenir à un domaine vérifié dans Resend
# (ex. "Site web <contact@domaine-du-client.fr>").
CONTACT_FROM=""
