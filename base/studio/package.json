{
  "name": "starter-template",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "prebuild": "npm run extract-types",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "extract-types": "sanity schema extract --enforce-required-fields --force",
    "fonts:sync": "node scripts/generate-google-fonts.mjs",
    "seed:contact": "sanity exec scripts/seed-contact-page.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "^6.3.0",
    "@sanity/icons": "^5.4.0",
    "@sanity/locale-fr-fr": "^1.2.37",
    "@sanity/table": "^3.1.21",
    "@sanity/types": "^6.25.0",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.25.0",
    "pluralize-esm": "^9.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.25.0",
    "sanity-plugin-simpler-color-input": "^4.1.0",
    "styled-components": "^6.7.0"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.3.2",
    "eslint": "^10.3.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
}
